# Supabase client config (public — safe to expose; VITE_ vars are bundled into the client build)
# Find these in your Supabase project: Settings → API
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# NOTE: Genuine secrets (e.g. FIRECRAWL_API_KEY) are NOT set here.
# They live server-side in the Supabase Edge Function environment, never in this repo.
